# ──────────────────────────────────────────────────────
# .env.example — Variables de entorno necesarias
# ──────────────────────────────────────────────────────

# PostgreSQL (Docker - puerto 5434)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5434/tienda_nube

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3090

# NextAuth v5 (generar con: openssl rand -base64 32)
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3090

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
AUTH_TRUST_HOST=true

# Cron job secret for /api/orders/expire (set a random string: openssl rand -hex 32)
CRON_SECRET=your_random_secret_here
